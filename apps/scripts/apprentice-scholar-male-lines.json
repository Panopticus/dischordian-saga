  },
  {
    "id": "scholar_male_quest_2_check",
    "character": "apprentice_scholar_male",
    "text": "Three drafts in. Each one weaker than the last. I'm rewriting from scratch.",
    "emotion": "raw",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "scholar_male_quest_followup_a",
    "character": "apprentice_scholar_male",
    "text": "The Antiquarian read the third draft. He marked four sentences. I'm keeping all of them.",
    "emotion": "wondering",
    "bucket": "quest",
