[
  {
    "id": "revenant_female_greet_1",
    "character": "apprentice_revenant_female",
    "text": "I came back. That's most of the introduction.",
    "emotion": "low",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_greet_2",
    "character": "apprentice_revenant_female",
    "text": "Welcome. I'll tell you which parts of my story you can ask about.",
    "emotion": "set",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_ambient_1",
    "character": "apprentice_revenant_female",
    "text": "I had a debt list in my coat pocket when I died. I keep finding new copies.",
    "emotion": "low",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_ambient_2",
    "character": "apprentice_revenant_female",
    "text": "There's a hum in this corridor that wasn't there before. Or after. Hard to tell.",
    "emotion": "wry",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_ambient_3",
    "character": "apprentice_revenant_female",
    "text": "Sleep doesn't take me anywhere new. That's fine. I'm not done with here.",
    "emotion": "still",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_deploy_1",
    "character": "apprentice_revenant_female",
    "text": "I've done this corridor before. Not the same way.",
    "emotion": "set",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_deploy_2",
    "character": "apprentice_revenant_female",
    "text": "Don't worry about me dying. I'm bad at it.",
    "emotion": "wry",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_outcome_won",
    "character": "apprentice_revenant_female",
    "text": "Crossed two names off. Three to go.",
    "emotion": "low",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_outcome_wounded",
    "character": "apprentice_revenant_female",
    "text": "Hurts the same. That's a relief, somehow.",
    "emotion": "wry",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_outcome_saw_death",
    "character": "apprentice_revenant_female",
    "text": "I know what she're feeling. I'll go sit with the body for a while.",
    "emotion": "mourning",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_outcome_other_died",
    "character": "apprentice_revenant_female",
    "text": "She got there before me. Add her name to my list. I'll finish what she started.",
    "emotion": "mourning",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_event_loredex",
    "character": "apprentice_revenant_female",
    "text": "That fragment? Mine. I think.",
    "emotion": "low",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_event_resurrection",
    "character": "apprentice_revenant_female",
    "text": "Welcome back. Don't try to remember everything at once. The hour after's the worst.",
    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_banter_died",
    "character": "apprentice_revenant_female",
    "text": "Yes I died. No I won't tell you how. Yes you can ask in three cycles.",
    "emotion": "edged",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_banter_finish",
    "character": "apprentice_revenant_female",
    "text": "There are five names I owe. Three are still alive. We could go.",
    "emotion": "set",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_quest_1_open",
    "character": "apprentice_revenant_female",
    "text": "First name on the debt list lives two sectors over. I'd like company.",
    "emotion": "set",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_quest_2_mid",
    "character": "apprentice_revenant_female",
    "text": "Found three. Two thanked me. One slammed the door.",
    "emotion": "wry",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_quest_3_break",
    "character": "apprentice_revenant_female",
    "text": "The last name on the list — it's mine. I don't know how to settle that one yet.",
    "emotion": "raw",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_romance_spark",
    "character": "apprentice_revenant_female",
    "text": "Slow steps. I came back walking funny.",
    "emotion": "soft",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_romance_courtship",
    "character": "apprentice_revenant_female",
    "text": "I die a little less when you laugh. Don't tell anyone.",
    "emotion": "tender",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_romance_committed",
    "character": "apprentice_revenant_female",
    "text": "I came back to finish what I'd left. I'm staying for what I've found.",
    "emotion": "warm",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_greet_3",
    "character": "apprentice_revenant_female",
    "text": "Welcome. The list is getting shorter. Slowly.",
    "emotion": "low",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_greet_4",
    "character": "apprentice_revenant_female",
    "text": "I'm okay. I'm here. Both true.",
    "emotion": "ready",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_ambient_4",
    "character": "apprentice_revenant_female",
    "text": "I keep finding things in pockets I don't remember filling.",
    "emotion": "wry",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_ambient_5",
    "character": "apprentice_revenant_female",
    "text": "The third name on my list runs a stall in the lower deck. They didn't recognize me.",
    "emotion": "low",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_ambient_6",
    "character": "apprentice_revenant_female",
    "text": "Sleep takes me to the same hallway twice a week. Different lighting each time.",
    "emotion": "still",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_ambient_7",
    "character": "apprentice_revenant_female",
    "text": "I'm not afraid of dying. I'm tired of starting over.",
    "emotion": "raw",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_ambient_8",
    "character": "apprentice_revenant_female",
    "text": "There's a fifth name I haven't written down. I don't trust myself with it yet.",
    "emotion": "edged",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_ambient_9",
    "character": "apprentice_revenant_female",
    "text": "The cadre patches have changed three times since I died. I'm still learning the new ones.",
    "emotion": "thoughtful",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_deploy_3",
    "character": "apprentice_revenant_female",
    "text": "I've done worse. Less prepared.",
    "emotion": "set",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_deploy_4",
    "character": "apprentice_revenant_female",
    "text": "I'll go first. I know the ground.",
    "emotion": "low",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_deploy_5",
    "character": "apprentice_revenant_female",
    "text": "Three crossings ahead. I marked the first two last cycle.",
    "emotion": "ready",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_outcome_won_2",
    "character": "apprentice_revenant_female",
    "text": "Crossed off the fourth. The fifth's a problem.",
    "emotion": "low",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_outcome_wounded_2",
    "character": "apprentice_revenant_female",
    "text": "Old wounds. New wounds. Same body. Same accountant.",
    "emotion": "wry",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_outcome_close_call",
    "character": "apprentice_revenant_female",
    "text": "I died in three of the dream variants. Not this one.",
    "emotion": "still",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_outcome_routine_lost",
    "character": "apprentice_revenant_female",
    "text": "Her unfinished business is mine now. I'll honor the addition.",
    "emotion": "mourning",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_event_act_complete",
    "character": "apprentice_revenant_female",
    "text": "Another act. Another set of names I should have written down.",
    "emotion": "thoughtful",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_event_npc_returned",
    "character": "apprentice_revenant_female",
    "text": "She're back. We compare notes on the boundary tonight.",
    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_event_betrayal_warning",
    "character": "apprentice_revenant_female",
    "text": "I've seen this before. The sequence is the same. The face is new.",
    "emotion": "edged",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_event_relationship_warm",
    "character": "apprentice_revenant_female",
    "text": "Two of you bonded in the alcove. I'm glad. The dead don't always get that.",
    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_event_demon_summon",
    "character": "apprentice_revenant_female",
    "text": "Bound spirits remind me of myself. Reluctant company.",
    "emotion": "low",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_event_apprentice_died",
    "character": "apprentice_revenant_female",
    "text": "I know what she're feeling. I'll go sit with the body. Once is enough for the witness.",
    "emotion": "mourning",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_event_resurrection_complete",
    "character": "apprentice_revenant_female",
    "text": "Welcome back. Whatever you remember, write it down. Tonight. While it's loud.",
    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_event_recruit_added",
    "character": "apprentice_revenant_female",
    "text": "Another name to learn. I'll forget it twice and remember the third time.",
    "emotion": "wry",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_event_first_costly_choice",
    "character": "apprentice_revenant_female",
    "text": "Difficult choices age you. I'd know.",
    "emotion": "low",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_banter_died_2",
    "character": "apprentice_revenant_female",
    "text": "I'll tell you how I died. Once. After the second mission.",
    "emotion": "edged",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_banter_finish_2",
    "character": "apprentice_revenant_female",
    "text": "I owe a name. We could go this cycle.",
    "emotion": "set",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_banter_grief",
    "character": "apprentice_revenant_female",
    "text": "Grief from the inside is just an extra job to keep up with.",
    "emotion": "still",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_quest_2_check",
    "character": "apprentice_revenant_female",
    "text": "Found the third name. He runs a paint shop now. He cried. I didn't.",
    "emotion": "raw",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_quest_followup_a",
    "character": "apprentice_revenant_female",
    "text": "The fourth name is dead. Already. I'll find the family.",
    "emotion": "still",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_quest_resolution_deep",
    "character": "apprentice_revenant_female",
    "text": "Crossed the last. The list is closed. The pen's heavier than I expected.",
    "emotion": "warm",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_quest_resolution_break",
    "character": "apprentice_revenant_female",
    "text": "I left one name uncrossed. I think I want to leave one. Always.",
    "emotion": "raw",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_romance_morning",
    "character": "apprentice_revenant_female",
    "text": "I wake before you. I count your breaths. It's allowed.",
    "emotion": "soft",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_female_romance_quiet_walk",
    "character": "apprentice_revenant_female",
    "text": "Walk with me. Don't ask. I'll tell you about a corner of my old life.",
    "emotion": "tender",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  }
]
