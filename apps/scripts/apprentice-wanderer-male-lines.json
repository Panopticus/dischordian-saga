  },
  {
    "id": "wanderer_male_event_npc_returned",
    "character": "apprentice_wanderer_male",
    "text": "He're back. We compared notes on hallways nobody else knows.",
    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_event_betrayal_warning",
    "character": "apprentice_wanderer_male",
    "text": "I've seen this kind of leaving before. They'll come back, but worse.",
    "emotion": "edged",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_event_relationship_warm",
