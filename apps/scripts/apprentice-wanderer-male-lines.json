    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_outcome_wounded_2",
    "character": "apprentice_wanderer_male",
    "text": "Boots full of someone else's blood. I'll change boots.",
    "emotion": "wry",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_outcome_close_call",
    "character": "apprentice_wanderer_male",
    "text": "Took the wrong turn. The wrong turn was the right one.",
    "emotion": "still",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_outcome_routine_lost",
    "character": "apprentice_wanderer_male",
    "text": "I'll walk his last route. Slow. Unhurried. The road won't notice.",
    "emotion": "still",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_event_act_complete",
