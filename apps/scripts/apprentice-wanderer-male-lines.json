  },
  {
    "id": "wanderer_male_greet_3",
    "character": "apprentice_wanderer_male",
    "text": "Welcome. I'll be here for a while. Two cycles, maybe three.",
    "emotion": "warm",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_greet_4",
    "character": "apprentice_wanderer_male",
    "text": "Hi. Just back from the lower corridor. There's a door I want to show you.",
    "emotion": "ready",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_ambient_4",
    "character": "apprentice_wanderer_male",
    "text": "I remember every room I've ever slept in. None of them are this one. Yet.",
    "emotion": "thoughtful",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_ambient_5",
    "character": "apprentice_wanderer_male",
    "text": "There's a sect on the third moon that disagrees with everyone. I miss them.",
    "emotion": "wry",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_ambient_6",
    "character": "apprentice_wanderer_male",
    "text": "The substrate has shortcuts the maps don't show. I'll mark three for you.",
    "emotion": "ready",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_ambient_7",
    "character": "apprentice_wanderer_male",
    "text": "I keep meaning to leave. I keep not leaving. I'll keep meaning.",
    "emotion": "wry",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_ambient_8",
    "character": "apprentice_wanderer_male",
    "text": "The kettle on the long table is one of mine. I left it three cycles back.",
    "emotion": "soft",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_ambient_9",
    "character": "apprentice_wanderer_male",
    "text": "Stories are road maps for places nobody walks anymore.",
    "emotion": "calm",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_deploy_3",
    "character": "apprentice_wanderer_male",
    "text": "I know the back routes. Even on planets I haven't been.",
    "emotion": "set",
    "bucket": "deploy",
