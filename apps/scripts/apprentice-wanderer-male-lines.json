  },
  {
    "id": "wanderer_male_ambient_1",
    "character": "apprentice_wanderer_male",
    "text": "There's a window in the cargo bay that opens onto somewhere it shouldn't.",
    "emotion": "thoughtful",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_ambient_2",
    "character": "apprentice_wanderer_male",
    "text": "I keep meaning to leave. It keeps not happening. Curious.",
    "emotion": "wry",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_ambient_3",
    "character": "apprentice_wanderer_male",
