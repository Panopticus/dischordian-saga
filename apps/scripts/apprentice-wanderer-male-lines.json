    "text": "Two crew claimed a route together. They'll walk it forever now.",
    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_event_demon_summon",
    "character": "apprentice_wanderer_male",
    "text": "Bound spirits travel with us. Just one more passenger.",
    "emotion": "thoughtful",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "wanderer_male_event_apprentice_died",
