[
  {
    "id": "ghost_male_greet_1",
    "character": "apprentice_ghost_male",
    "text": "You found me. That's rarer than you think.",
    "emotion": "low",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_greet_2",
    "character": "apprentice_ghost_male",
    "text": "Don't say my name in the hallway. I'll come to you.",
    "emotion": "private",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_ambient_1",
    "character": "apprentice_ghost_male",
    "text": "I was already here.",
    "emotion": "flat",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_ambient_2",
    "character": "apprentice_ghost_male",
    "text": "The cameras blink at the same intervals. It's almost a song.",
    "emotion": "wry",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_ambient_3",
    "character": "apprentice_ghost_male",
    "text": "Three exits from this room. Four if you count the obvious one.",
    "emotion": "calm",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_deploy_1",
    "character": "apprentice_ghost_male",
    "text": "I'll take the angle nobody's watching.",
    "emotion": "set",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_deploy_2",
    "character": "apprentice_ghost_male",
    "text": "If I'm not back, I left.",
    "emotion": "edged",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_outcome_won",
    "character": "apprentice_ghost_male",
    "text": "Quietly. Better that way.",
    "emotion": "low",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_outcome_wounded",
    "character": "apprentice_ghost_male",
    "text": "I knew the room. I missed the floor.",
    "emotion": "wry",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_outcome_saw_death",
    "character": "apprentice_ghost_male",
    "text": "I noticed him before I knew I was watching. He won't be unnoticed now.",
    "emotion": "still",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_outcome_other_died",
    "character": "apprentice_ghost_male",
    "text": "I memorized the path he walked. It deserves a witness.",
    "emotion": "still",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_event_loredex",
    "character": "apprentice_ghost_male",
    "text": "There's another shape in the gap. I'll mark it.",
    "emotion": "low",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_event_npc_dies",
    "character": "apprentice_ghost_male",
    "text": "I noticed him. He knew that. I think it mattered to him.",
    "emotion": "still",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_banter_visible",
    "character": "apprentice_ghost_male",
    "text": "Don't put me in the photograph. I'll be in the photograph.",
    "emotion": "wry",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_banter_quiet",
    "character": "apprentice_ghost_male",
    "text": "I keep a list of people who notice me. It's short. You're on it.",
    "emotion": "soft",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_quest_1_open",
    "character": "apprentice_ghost_male",
    "text": "Someone's been watching him. He don't know yet. I want to know who first.",
    "emotion": "edged",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_quest_2_mid",
    "character": "apprentice_ghost_male",
    "text": "I followed the watcher home. The address was familiar. That's not coincidence.",
    "emotion": "set",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_quest_3_break",
    "character": "apprentice_ghost_male",
    "text": "He's seeing me back. I can stop being unseen now. Or I can keep going.",
    "emotion": "raw",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_romance_spark",
    "character": "apprentice_ghost_male",
    "text": "Don't say it out loud. I heard you anyway.",
    "emotion": "soft",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_romance_courtship",
    "character": "apprentice_ghost_male",
    "text": "Months of glances. I counted every one. Don't count yours.",
    "emotion": "tender",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_romance_committed",
    "character": "apprentice_ghost_male",
    "text": "I'll stay seen. With you. Only with you.",
    "emotion": "warm",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_greet_3",
    "character": "apprentice_ghost_male",
    "text": "You found the second me. There's a third. Don't look.",
    "emotion": "low",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_greet_4",
    "character": "apprentice_ghost_male",
    "text": "I'd offer tea. You'd say no. Save us both the words.",
    "emotion": "wry",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_ambient_4",
    "character": "apprentice_ghost_male",
    "text": "I counted the engineer's breaths last shift. Eighteen per minute. Stable.",
    "emotion": "low",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_ambient_5",
    "character": "apprentice_ghost_male",
    "text": "Three of you here have me on a list. None of you have it correct.",
    "emotion": "wry",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_ambient_6",
    "character": "apprentice_ghost_male",
    "text": "The maintenance loop on Deck 4 ends in a closet. The closet has a door I haven't opened.",
    "emotion": "thoughtful",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_ambient_7",
    "character": "apprentice_ghost_male",
    "text": "I left a chalk mark on the rail. It's gone. Someone else watches.",
    "emotion": "edged",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_ambient_8",
    "character": "apprentice_ghost_male",
    "text": "My presence is a courtesy. My absence is a verdict.",
    "emotion": "calm",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_ambient_9",
    "character": "apprentice_ghost_male",
    "text": "I've memorized the daily rotations. Yours is off by twelve seconds.",
    "emotion": "wry",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_deploy_3",
    "character": "apprentice_ghost_male",
    "text": "I'll already be inside before the briefing ends.",
    "emotion": "set",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_deploy_4",
    "character": "apprentice_ghost_male",
    "text": "Don't search for me. I'll be where the lights flicker.",
    "emotion": "low",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_deploy_5",
    "character": "apprentice_ghost_male",
    "text": "The angle nobody covers is mine.",
    "emotion": "edged",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_outcome_won_2",
    "character": "apprentice_ghost_male",
    "text": "The watch never knew I was there. That's the win.",
    "emotion": "low",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_outcome_wounded_2",
    "character": "apprentice_ghost_male",
    "text": "I broke pattern once. The floor caught me. Pattern resumes.",
    "emotion": "wry",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_outcome_close_call",
    "character": "apprentice_ghost_male",
    "text": "I was on the wrong side of a door for thirty seconds. They won't know.",
    "emotion": "still",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_outcome_routine_lost",
    "character": "apprentice_ghost_male",
    "text": "He died alone. Nobody else saw. I did. I'll write it down.",
    "emotion": "mourning",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_event_act_complete",
    "character": "apprentice_ghost_male",
    "text": "Three corridors reset. The new layout is mine to learn.",
    "emotion": "ready",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_event_npc_returned",
    "character": "apprentice_ghost_male",
    "text": "He're back. He found me first. He didn't say.",
    "emotion": "still",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_event_betrayal_warning",
    "character": "apprentice_ghost_male",
    "text": "I heard them planning. They didn't see me. I'm reporting now.",
    "emotion": "edged",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_event_relationship_warm",
    "character": "apprentice_ghost_male",
    "text": "Two crew in the alcove. They didn't know I left. I left.",
    "emotion": "low",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_event_demon_summon",
    "character": "apprentice_ghost_male",
    "text": "It looked at me. I'm being remembered by something that shouldn't.",
    "emotion": "still",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_event_apprentice_died",
    "character": "apprentice_ghost_male",
    "text": "I'll watch where he used to walk. The route gets harder.",
    "emotion": "mourning",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_event_recruit_added",
    "character": "apprentice_ghost_male",
    "text": "New crew. They don't see me yet. They will, slowly.",
    "emotion": "wry",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_event_first_costly_choice",
    "character": "apprentice_ghost_male",
    "text": "I noticed your shoulders before your face. The decision was already made.",
    "emotion": "soft",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_event_dialog_overheard",
    "character": "apprentice_ghost_male",
    "text": "I heard them. Don't ask me what. I'll tell you when it matters.",
    "emotion": "edged",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_banter_visible_2",
    "character": "apprentice_ghost_male",
    "text": "Don't introduce me. I introduce myself to who I want.",
    "emotion": "edged",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_banter_quiet_2",
    "character": "apprentice_ghost_male",
    "text": "Sit beside me. Don't fill the silence. I'll fill it if I need to.",
    "emotion": "soft",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_banter_loud",
    "character": "apprentice_ghost_male",
    "text": "Keep your voice down. The room hears better at this hour.",
    "emotion": "wry",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_quest_2_check",
    "character": "apprentice_ghost_male",
    "text": "I followed the watcher. They circled the lower deck three times. I'll write what they were looking at.",
    "emotion": "set",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_quest_followup_a",
    "character": "apprentice_ghost_male",
    "text": "The watcher noticed I noticed. We've reached an understanding.",
    "emotion": "low",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_quest_resolution_deep",
    "character": "apprentice_ghost_male",
    "text": "He sees me now. I'm letting it stay that way. With you.",
    "emotion": "tender",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_quest_resolution_break",
    "character": "apprentice_ghost_male",
    "text": "I broke pattern. He ran. I let him. The watcher is now me.",
    "emotion": "raw",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_romance_solo",
    "character": "apprentice_ghost_male",
    "text": "Don't write about us. I'll know if you do.",
    "emotion": "edged",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_romance_anonymous_gift",
    "character": "apprentice_ghost_male",
    "text": "I left a coin on your bunk. You knew which one.",
    "emotion": "soft",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "ghost_male_dlg_past_opener_0",
    "character": "apprentice_ghost_male",
    "text": "There was a kitchen door in the house I grew up in. The hinge squeaked at exactly thirty-six degrees of opening.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "ghost_male_dlg_past_opener_1",
    "character": "apprentice_ghost_male",
    "text": "I learned to walk through it at thirty-five.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "ghost_male_dlg_past_g_past_warm_reply_0",
    "character": "apprentice_ghost_male",
    "text": "Being seen by my mother before she had her tea. It saved both of us a lot of resentment. She never thanked me. I never asked her to.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "ghost_male_dlg_past_g_past_probe_reply_0",
    "character": "apprentice_ghost_male",
    "text": "Twelve. There was a man in our neighbourhood who liked to know where people were. I learned to be where he was not.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "ghost_male_dlg_past_g_past_probe_g_past_probe_deep_reply_0",
    "character": "apprentice_ghost_male",
    "text": "I came for him. Once. He did not see me. He knew I had been there. He moved away within the cycle. I have never confirmed which house.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "ghost_male_dlg_past_g_past_probe_g_past_probe_back_reply_0",
    "character": "apprentice_ghost_male",
    "text": "Don't be sorry. The skill is the only thing he gave me. It has paid for itself many times.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "ghost_male_dlg_past_g_past_cold_reply_0",
    "character": "apprentice_ghost_male",
    "text": "Common, yes. The detail you missed is the one that made it mine. I won't give it to you tonight.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "ghost_male_dlg_calling_opener_0",
    "character": "apprentice_ghost_male",
    "text": "Patterns. The thing that breaks before the thing that breaks.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "ghost_male_dlg_calling_opener_1",
    "character": "apprentice_ghost_male",
    "text": "Three of you have it. The other crew don't notice yet. I'm watching to see who breaks visibly first.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "ghost_male_dlg_calling_g_call_warm_reply_0",
    "character": "apprentice_ghost_male",
    "text": "I'll tell you when I'm wrong about one of them. You don't need a list of names. You need to be the kind of person whose checking on them is welcome.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "ghost_male_dlg_calling_g_call_probe_reply_0",
    "character": "apprentice_ghost_male",
    "text": "You're not on the list. You're the reason the list exists. I started keeping it the first time you slept badly.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "ghost_male_dlg_calling_g_call_probe_g_call_probe_deep_reply_0",
    "character": "apprentice_ghost_male",
    "text": "You drink water before you eat. Always. You have done it since the second cycle on this ark. You hadn't done it before. Something taught you. You haven't told anyone what.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "ghost_male_dlg_calling_g_call_probe_g_call_probe_deep_reply_1",
    "character": "apprentice_ghost_male",
    "text": "I'll wait for you to tell me. Not the other way around.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "ghost_male_dlg_calling_g_call_probe_g_call_probe_back_reply_0",
    "character": "apprentice_ghost_male",
    "text": "Then I'll observe less. You'll know I have. The withdrawal is also information you might want.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "ghost_male_dlg_calling_g_call_cold_reply_0",
    "character": "apprentice_ghost_male",
    "text": "The list is the only way I rest. Take it from me and I work harder, not less. I'll keep it quieter.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "ghost_male_dlg_mortality_opener_0",
    "character": "apprentice_ghost_male",
    "text": "Don't mark the chair. Don't put a candle on the bench.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "ghost_male_dlg_mortality_opener_1",
    "character": "apprentice_ghost_male",
    "text": "If you must do something, leave the cargo-bay window open. I left it like that on purpose.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "ghost_male_dlg_mortality_g_mort_warm_reply_0",
    "character": "apprentice_ghost_male",
    "text": "Then mark it small. A piece of chalk on the floor under it. Nobody else will see. You will. I will, where I've gone.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "ghost_male_dlg_mortality_g_mort_probe_reply_0",
    "character": "apprentice_ghost_male",
    "text": "Because I left through it twice. Once on purpose. Once because the door was locked and I needed the cycle outside.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "ghost_male_dlg_mortality_g_mort_probe_g_mort_probe_deep_reply_0",
    "character": "apprentice_ghost_male",
    "text": "There was a fire. Crew-three didn't make it. I was outside on the rail when the door sealed. I came back through the same window when the heat dropped. The crew wrote me up as a casualty for nine hours.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "ghost_male_dlg_mortality_g_mort_probe_g_mort_probe_deep_reply_1",
    "character": "apprentice_ghost_male",
    "text": "I never corrected the record. The version of me who didn't come back is also true.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "ghost_male_dlg_mortality_g_mort_probe_g_mort_probe_back_reply_0",
    "character": "apprentice_ghost_male",
    "text": "Just the window. Thank you for not pressing further.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "ghost_male_dlg_mortality_g_mort_cold_reply_0",
    "character": "apprentice_ghost_male",
    "text": "Then put my name. Just the name. Not the date. Not the cause. The wall does not need the rest. Neither do I.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "ghost_male_dlg_us_opener_0",
    "character": "apprentice_ghost_male",
    "text": "You catch me. Not always. Often enough that I've stopped flinching.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "ghost_male_dlg_us_opener_1",
    "character": "apprentice_ghost_male",
    "text": "I keep the count: forty-three times so far. The forty-fourth I'll tell you after.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "ghost_male_dlg_us_g_us_warm_reply_0",
    "character": "apprentice_ghost_male",
    "text": "Then meet me in the cargo bay at the third bell. I'll come from the window, not the door. You will see me arrive. I will not flinch.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "ghost_male_dlg_us_g_us_probe_reply_0",
    "character": "apprentice_ghost_male",
    "text": "Each one is the version of me you saw. I did not realise how many versions there were until you started cataloguing. You do not write them down. You should know I do.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "ghost_male_dlg_us_g_us_probe_g_us_probe_deep_reply_0",
    "character": "apprentice_ghost_male",
    "text": "Twenty-two. Cycle nine. You looked up from a manifest. I was on the gantry. You held the look. I did not move. You went back to the manifest. You wrote nothing.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "ghost_male_dlg_us_g_us_probe_g_us_probe_deep_reply_1",
    "character": "apprentice_ghost_male",
    "text": "I wrote: 'She did not write. She let me stand there.'",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "ghost_male_dlg_us_g_us_probe_g_us_probe_step_reply_0",
    "character": "apprentice_ghost_male",
    "text": "It's not sad. It's evidence. Most evidence isn't sad until someone reads it wrong.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "ghost_male_dlg_us_g_us_cold_reply_0",
    "character": "apprentice_ghost_male",
    "text": "I can stop the count. I can't stop noticing. You'll have to take the noticing without the bookkeeping.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  }
]
