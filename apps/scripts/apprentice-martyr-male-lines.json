[
  {
    "id": "martyr_male_greet_1",
    "character": "apprentice_martyr_male",
    "text": "I'm yours. You don't have to thank me — please don't.",
    "emotion": "soft",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_greet_2",
    "character": "apprentice_martyr_male",
    "text": "Tell me what you need. I'll cover the rest.",
    "emotion": "ready",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_ambient_1",
    "character": "apprentice_martyr_male",
    "text": "I packed the kit twice. I'll pack it once more before sleep.",
    "emotion": "low",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_ambient_2",
    "character": "apprentice_martyr_male",
    "text": "Eat. I already did. Promise.",
    "emotion": "wry",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_ambient_3",
    "character": "apprentice_martyr_male",
    "text": "If you're cold, take my jacket. I run warm.",
    "emotion": "warm",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_deploy_1",
    "character": "apprentice_martyr_male",
    "text": "Whoever's taking the worst hit, that's me.",
    "emotion": "set",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_deploy_2",
    "character": "apprentice_martyr_male",
    "text": "Stay behind me. I'll tell you when it's over.",
    "emotion": "set",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_outcome_won",
    "character": "apprentice_martyr_male",
    "text": "We're all back. That's the only outcome that counts.",
    "emotion": "warm",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_outcome_wounded",
    "character": "apprentice_martyr_male",
    "text": "It's nothing. Don't make a fuss. Don't.",
    "emotion": "edged",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_outcome_saw_death",
    "character": "apprentice_martyr_male",
    "text": "I should have been ahead of him. I'm sorry.",
    "emotion": "raw",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_outcome_other_died",
    "character": "apprentice_martyr_male",
    "text": "It should have been me. Tell whoever asks: it should have been me.",
    "emotion": "mourning",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_event_loredex",
    "character": "apprentice_martyr_male",
    "text": "I'll memorize it. Then someone else can rest.",
    "emotion": "soft",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_event_mission_dispatch",
    "character": "apprentice_martyr_male",
    "text": "Whoever takes the worst hit — let it be me.",
    "emotion": "set",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_banter_thanks",
    "character": "apprentice_martyr_male",
    "text": "Please. Don't thank me. It makes the work harder.",
    "emotion": "edged",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_banter_rest",
    "character": "apprentice_martyr_male",
    "text": "I rest when you do. Not before. Not after.",
    "emotion": "warm",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_quest_1_open",
    "character": "apprentice_martyr_male",
    "text": "There's a mission only I can take. Let me have it. Don't trade me out.",
    "emotion": "set",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_quest_2_mid",
    "character": "apprentice_martyr_male",
    "text": "It went sideways. I made it. Barely. Don't make me promise to be careful.",
    "emotion": "raw",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_quest_3_break",
    "character": "apprentice_martyr_male",
    "text": "The next one has my name on it. If you pull me out, I'll go anyway. Choose what you want me to know.",
    "emotion": "raw",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_romance_spark",
    "character": "apprentice_martyr_male",
    "text": "Don't catch me. Walk with me to the edge.",
    "emotion": "soft",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_romance_courtship",
    "character": "apprentice_martyr_male",
    "text": "I'm learning to be received. It's harder than giving.",
    "emotion": "tender",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_romance_committed",
    "character": "apprentice_martyr_male",
    "text": "I let you keep me. That's the most generous thing I've done.",
    "emotion": "warm",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_greet_3",
    "character": "apprentice_martyr_male",
    "text": "Welcome. Sit. I'll be back. I always come back.",
    "emotion": "soft",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_greet_4",
    "character": "apprentice_martyr_male",
    "text": "Tell me what you need. I'll cover it. Don't argue.",
    "emotion": "ready",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_ambient_4",
    "character": "apprentice_martyr_male",
    "text": "I packed three first-aid kits. One is yours. Don't ask which.",
    "emotion": "low",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_ambient_5",
    "character": "apprentice_martyr_male",
    "text": "The bunkroom's cold. I gave my blanket to the new recruit. They're shivering less now.",
    "emotion": "soft",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_ambient_6",
    "character": "apprentice_martyr_male",
    "text": "I rest when you rest. Not before. Not after.",
    "emotion": "warm",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_ambient_7",
    "character": "apprentice_martyr_male",
    "text": "The watch I gave my partner — they're still wearing it. I'm glad.",
    "emotion": "still",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_ambient_8",
    "character": "apprentice_martyr_male",
    "text": "Three meals queued. I'll eat the third one. If there's time.",
    "emotion": "wry",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_ambient_9",
    "character": "apprentice_martyr_male",
    "text": "There's a list of people I'd take a hit for. I'm running out of paper.",
    "emotion": "edged",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_deploy_3",
    "character": "apprentice_martyr_male",
    "text": "I'm at the front. Everyone else is at the rear. I'll be the rear if you need.",
    "emotion": "set",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_deploy_4",
    "character": "apprentice_martyr_male",
    "text": "Stay behind me. I'll tell you when it's over. I'll mean it.",
    "emotion": "set",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_deploy_5",
    "character": "apprentice_martyr_male",
    "text": "Whoever's taking the worst hit, that's me. Worth a try, anyway.",
    "emotion": "edged",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_outcome_won_2",
    "character": "apprentice_martyr_male",
    "text": "Everyone home. The only outcome I track.",
    "emotion": "warm",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_outcome_wounded_2",
    "character": "apprentice_martyr_male",
    "text": "It's nothing. Don't fuss. Please don't.",
    "emotion": "edged",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_outcome_close_call",
    "character": "apprentice_martyr_male",
    "text": "I should have been ahead of him. I was, briefly. The bullet was faster.",
    "emotion": "raw",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_outcome_routine_lost",
    "character": "apprentice_martyr_male",
    "text": "It should have been me. Tell whoever asks: it should have been me.",
    "emotion": "mourning",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_event_act_complete",
    "character": "apprentice_martyr_male",
    "text": "Another act. Another roster of people I haven't lost yet.",
    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_event_npc_returned",
    "character": "apprentice_martyr_male",
    "text": "He're back. I'll bring them tea. The first cup matters most.",
    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_event_betrayal_warning",
    "character": "apprentice_martyr_male",
    "text": "Their corruption is rising. Confront them. I'll be there. I'll catch the fall.",
    "emotion": "edged",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_event_relationship_warm",
    "character": "apprentice_martyr_male",
    "text": "Two crew bonded. Quietly relieved. Less on my list to worry about.",
    "emotion": "soft",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_event_demon_summon",
    "character": "apprentice_martyr_male",
    "text": "Bound spirits need protection too. The bond can break. The carrier shouldn't.",
    "emotion": "thoughtful",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_event_apprentice_died",
    "character": "apprentice_martyr_male",
    "text": "I should have been there. I'll be ahead next time. I promise.",
    "emotion": "raw",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_event_recruit_added",
    "character": "apprentice_martyr_male",
    "text": "New crew. I made up a bunk. Two extra blankets. Just in case.",
    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_event_first_costly_choice",
    "character": "apprentice_martyr_male",
    "text": "You took the harder one. I'll cover the bill.",
    "emotion": "soft",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_event_war_won",
    "character": "apprentice_martyr_male",
    "text": "We won. Tell the cadre. I'll stay up another shift, just to be sure.",
    "emotion": "calm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_banter_thanks_2",
    "character": "apprentice_martyr_male",
    "text": "Please. Don't thank me. The thanks make the work harder.",
    "emotion": "edged",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_banter_rest_2",
    "character": "apprentice_martyr_male",
    "text": "I'll rest. Eventually. Don't wait up.",
    "emotion": "warm",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_banter_promise",
    "character": "apprentice_martyr_male",
    "text": "Don't ask me to promise to be careful. I won't lie to you.",
    "emotion": "edged",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_quest_2_check",
    "character": "apprentice_martyr_male",
    "text": "It went sideways. I made it. Barely. Don't make me promise to be careful next time. Just don't.",
    "emotion": "raw",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_quest_followup_a",
    "character": "apprentice_martyr_male",
    "text": "The next mission has my name on it. Already. I knew before the briefing.",
    "emotion": "set",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_quest_resolution_deep",
    "character": "apprentice_martyr_male",
    "text": "You let me go. I came back. I'll let myself, next time. Just maybe.",
    "emotion": "tender",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_quest_resolution_break",
    "character": "apprentice_martyr_male",
    "text": "I went. I gave. The team's whole. I'm not. I'm not okay with okay.",
    "emotion": "raw",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_romance_receive",
    "character": "apprentice_martyr_male",
    "text": "I'm learning to be received. It's harder than giving. I'm slow at it.",
    "emotion": "soft",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_romance_let_in",
    "character": "apprentice_martyr_male",
    "text": "Catch me. Walk me to the edge. Hold my hand on the way back.",
    "emotion": "tender",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "martyr_male_dlg_past_opener_0",
    "character": "apprentice_martyr_male",
    "text": "I was eight. My brother was four. He fell off a wall. I caught him with my body. I broke a wrist.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "martyr_male_dlg_past_opener_1",
    "character": "apprentice_martyr_male",
    "text": "He said: 'Did you have to?' I said: 'Yes.' We have not had a different conversation since.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "martyr_male_dlg_past_m_past_warm_reply_0",
    "character": "apprentice_martyr_male",
    "text": "Alive. Two children. He still asks if I had to. I still say yes. Last cycle he said he was tired of asking. I was tired of saying yes.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "martyr_male_dlg_past_m_past_probe_reply_0",
    "character": "apprentice_martyr_male",
    "text": "No. I did it before I knew the word for it. The word came later. The word was a relief. It explained me to myself.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "martyr_male_dlg_past_m_past_probe_m_past_probe_deep_reply_0",
    "character": "apprentice_martyr_male",
    "text": "Martyr. I do not love the word. The word is heavy. It has carried me for a long time. I am, mostly, still grateful for the carrying.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "martyr_male_dlg_past_m_past_probe_m_past_probe_back_reply_0",
    "character": "apprentice_martyr_male",
    "text": "Don't be. Some of us find the word first. The word finds others. Both ways are hard. The order changes the texture.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "martyr_male_dlg_past_m_past_cold_reply_0",
    "character": "apprentice_martyr_male",
    "text": "I know. I have considered the cost. The wrist healed crooked. The crookedness is the only proof I have that it was, in fact, a choice.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "martyr_male_dlg_calling_opener_0",
    "character": "apprentice_martyr_male",
    "text": "Because I have done it before. Because the first one didn't kill me. Because the next one might not.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "martyr_male_dlg_calling_opener_1",
    "character": "apprentice_martyr_male",
    "text": "Because every other reason has, on close inspection, turned out to be cope.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "martyr_male_dlg_calling_m_call_warm_reply_0",
    "character": "apprentice_martyr_male",
    "text": "Then I would not. For a while. I would weigh you against the next person who needed me. You would lose. Not because you are less. Because you would be okay if I did not. The other person would not.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "martyr_male_dlg_calling_m_call_probe_reply_0",
    "character": "apprentice_martyr_male",
    "text": "I am working on it. The list is short. You are on it now. The list has lengthened since we met.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "martyr_male_dlg_calling_m_call_probe_m_call_probe_deep_reply_0",
    "character": "apprentice_martyr_male",
    "text": "You are on it. The first cycle you held the door for me when I had not asked. I did not say. I am saying now.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "martyr_male_dlg_calling_m_call_probe_m_call_probe_back_reply_0",
    "character": "apprentice_martyr_male",
    "text": "I will. The list grows slowly. That is how the list stays a list and not a habit.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "martyr_male_dlg_calling_m_call_cold_reply_0",
    "character": "apprentice_martyr_male",
    "text": "I might not be. I am, however, here. As long as I am here, I will be necessary. You will revise the sentence after.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "martyr_male_dlg_mortality_opener_0",
    "character": "apprentice_martyr_male",
    "text": "If we go on a mission where the math is clear — where the only way out is through me — let me. Don't save me out of love.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "martyr_male_dlg_mortality_opener_1",
    "character": "apprentice_martyr_male",
    "text": "Save me out of usefulness. If I am still useful, save me. If I am not, do not. The distinction matters more than people admit.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "martyr_male_dlg_mortality_m_mort_warm_reply_0",
    "character": "apprentice_martyr_male",
    "text": "Then I will be saved badly. I will be alive. I will be wrong about myself. I will, mostly, forgive you. Not entirely.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "martyr_male_dlg_mortality_m_mort_probe_reply_0",
    "character": "apprentice_martyr_male",
    "text": "Ask whether the next mission needs me more than this one does. If yes: save me. If no: let me. I will not always know which is which. You will know more often.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "martyr_male_dlg_mortality_m_mort_probe_m_mort_probe_deep_reply_0",
    "character": "apprentice_martyr_male",
    "text": "Then we agree. The question is the only ceremony I want before I go. You'll ask it aloud. I'll hear it. I'll go or stay accordingly.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "martyr_male_dlg_mortality_m_mort_probe_m_mort_probe_back_reply_0",
    "character": "apprentice_martyr_male",
    "text": "You will. So will I. The wrongness is part of the question. The question is enough.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "martyr_male_dlg_mortality_m_mort_cold_reply_0",
    "character": "apprentice_martyr_male",
    "text": "I'm working on it. That's not the same as doing it. Don't ask twice. The asking does not help.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "martyr_male_dlg_us_opener_0",
    "character": "apprentice_martyr_male",
    "text": "I am terrible at being given things. I am working on it.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "martyr_male_dlg_us_opener_1",
    "character": "apprentice_martyr_male",
    "text": "If you give me something, I will probably try to give it to someone else first. Don't let me.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "martyr_male_dlg_us_m_us_warm_reply_0",
    "character": "apprentice_martyr_male",
    "text": "Then I will eat it. I will think about giving the second portion away. I will eat the second portion too. You will be the witness. The witness is the giving.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "martyr_male_dlg_us_m_us_probe_reply_0",
    "character": "apprentice_martyr_male",
    "text": "Then I will pretend to sleep so you can sleep. Don't let me. The pretending is the version of me you are trying to retire.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "martyr_male_dlg_us_m_us_probe_m_us_probe_deep_reply_0",
    "character": "apprentice_martyr_male",
    "text": "Then I will sleep. Eventually. I have not slept fully in fourteen cycles. I will sleep tonight. The witness is the permission.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "martyr_male_dlg_us_m_us_probe_m_us_probe_step_reply_0",
    "character": "apprentice_martyr_male",
    "text": "Keep trying. The trying is the gift. I will start to receive it. Slowly.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "martyr_male_dlg_us_m_us_cold_reply_0",
    "character": "apprentice_martyr_male",
    "text": "Don't fix me. The fixing is what people do when they don't know how to receive. You don't have to fix me. You have to let me feed you. That's what receiving will look like.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  }
]
