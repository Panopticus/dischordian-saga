    "emotion": "warm",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_outcome_wounded",
    "character": "apprentice_zealot_female",
    "text": "She took the cut for me. She shouldn't have. I'll repay it before the Cause asks.",
    "emotion": "wounded",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_outcome_saw_death",
    "character": "apprentice_zealot_female",
