    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_quest_2_mid",
    "character": "apprentice_zealot_female",
    "text": "I checked the manuscript. Three of the lines — they're mine, but I never wrote them down.",
    "emotion": "shaken",
