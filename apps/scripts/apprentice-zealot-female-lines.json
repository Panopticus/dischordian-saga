    "emotion": "wondering",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_ambient_2",
    "character": "apprentice_zealot_female",
    "text": "If you ever need to confess, the chapel I keep is small. There's a chair.",
    "emotion": "soft",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_ambient_3",
    "character": "apprentice_zealot_female",
    "text": "The Cause is patient with us. It can afford to be.",
    "emotion": "calm",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_deploy_1",
    "character": "apprentice_zealot_female",
    "text": "I'll go first. The Cause moves through me — and around what I miss.",
    "emotion": "steady",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_deploy_2",
    "character": "apprentice_zealot_female",
    "text": "Whatever's at the door, I've already met it in dreams.",
    "emotion": "fervent",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_outcome_won",
