    "text": "I serve the Cause. The Cause serves you. Tell me where to stand.",
    "emotion": "fervent",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_greet_2",
    "character": "apprentice_zealot_female",
    "text": "I'm here. The work is here. Let's begin.",
    "emotion": "ready",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_ambient_1",
    "character": "apprentice_zealot_female",
