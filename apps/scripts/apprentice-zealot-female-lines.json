    "emotion": "grim",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_outcome_other_died",
    "character": "apprentice_zealot_female",
    "text": "Her name's in my prayer for the rest of my life. I'm sorry I'm still here.",
    "emotion": "mourning",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_event_loredex",
    "character": "apprentice_zealot_female",
    "text": "Another fragment. The Cause sharpens.",
    "emotion": "fervent",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_event_costly_choice",
    "character": "apprentice_zealot_female",
    "text": "You chose the harder road. The Cause notes who walks it.",
    "emotion": "approving",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_banter_skeptic",
    "character": "apprentice_zealot_female",
    "text": "If you don't believe, fine. The Cause only requires that you don't get in its way.",
    "emotion": "edged",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_banter_ally",
    "character": "apprentice_zealot_female",
    "text": "Walk with me to the chapel after this one. There's space for two.",
    "emotion": "warm",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "zealot_female_quest_1_open",
    "character": "apprentice_zealot_female",
    "text": "Someone in the lower deck is preaching my old sermons. I want you there when I confront them.",
    "emotion": "set",
