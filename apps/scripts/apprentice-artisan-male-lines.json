  },
  {
    "id": "artisan_male_outcome_wounded_2",
    "character": "apprentice_artisan_male",
    "text": "I'll repair the joint. The joint is me. The metaphor is recursive.",
    "emotion": "wry",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_outcome_close_call",
    "character": "apprentice_artisan_male",
    "text": "The hilt held. Two centimetres further it wouldn't have. The hilt held.",
    "emotion": "still",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_outcome_routine_lost",
    "character": "apprentice_artisan_male",
    "text": "I'll keep one piece for him. Their signature stays. The piece is theirs.",
    "emotion": "mourning",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_event_act_complete",
    "character": "apprentice_artisan_male",
    "text": "Another act. Three new commissions queued.",
    "emotion": "ready",
