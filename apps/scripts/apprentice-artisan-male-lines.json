    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_event_betrayal_warning",
    "character": "apprentice_artisan_male",
    "text": "Their sigil is two degrees off. Not by accident.",
    "emotion": "edged",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_event_relationship_warm",
    "character": "apprentice_artisan_male",
    "text": "Two crew at the long table. I'll engrave a token. Quietly.",
    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_event_demon_summon",
    "character": "apprentice_artisan_male",
    "text": "I want to study its sigils. Just the ones that don't bite.",
    "emotion": "thoughtful",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_event_apprentice_died",
    "character": "apprentice_artisan_male",
    "text": "I'll make him a memorial. Heavy. On purpose. The Wraith Calder will know what to do with it.",
    "emotion": "mourning",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_event_recruit_added",
    "character": "apprentice_artisan_male",
    "text": "New crew. They asked me what I make. I showed them. Now they're a customer.",
    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_event_loredex_found",
    "character": "apprentice_artisan_male",
    "text": "There's a maker's mark in the entry. I know it. The maker is older than three of our centuries.",
    "emotion": "thrilled",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_event_recipe_acquired",
    "character": "apprentice_artisan_male",
    "text": "Three new recipes. The middle one is interesting. The other two are warnings.",
    "emotion": "thoughtful",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_banter_critique_2",
    "character": "apprentice_artisan_male",
    "text": "Critique me when the work's cool. Not before. Not before.",
    "emotion": "edged",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_banter_watch_2",
    "character": "apprentice_artisan_male",
    "text": "Sit. The hum's good for the work. The hum is half the work.",
    "emotion": "warm",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_banter_apprentice",
    "character": "apprentice_artisan_male",
    "text": "I'd take an apprentice. They'd hate me for the first month. Then they'd be patient.",
    "emotion": "wry",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_quest_2_check",
    "character": "apprentice_artisan_male",
    "text": "The piece is finished. They haven't picked it up. I'll wait. The piece will outlast both of us anyway.",
    "emotion": "raw",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_quest_followup_a",
    "character": "apprentice_artisan_male",
    "text": "They asked me to alter it. The alteration would weaken the joint. I refused. They're upset.",
    "emotion": "set",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_quest_resolution_deep",
    "character": "apprentice_artisan_male",
    "text": "I delivered. They wept on the bench. I left them with it.",
    "emotion": "warm",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_quest_resolution_break",
    "character": "apprentice_artisan_male",
    "text": "I altered. The joint weakened. The piece will fail in three cycles. They asked. I served.",
    "emotion": "raw",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_romance_handmade",
    "character": "apprentice_artisan_male",
    "text": "I made you a thing. It's small. Don't lose it. Don't polish it.",
    "emotion": "soft",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_romance_workshop",
    "character": "apprentice_artisan_male",
    "text": "Stay in the workshop. Don't talk. The hum needs us both.",
    "emotion": "tender",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_dlg_past_opener_0",
    "character": "apprentice_artisan_male",
    "text": "A wooden spoon. I was nine. The handle was crooked. My mother used it for forty years.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "artisan_male_dlg_past_opener_1",
    "character": "apprentice_artisan_male",
    "text": "She left a notch on it. The notch is the only signature I have ever wanted on my work.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "artisan_male_dlg_past_a_past_warm_reply_0",
    "character": "apprentice_artisan_male",
    "text": "In my workshop. Behind the calibration jig. I take it out when I'm calibrating. The notch reminds me what I'm calibrating *for*.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "artisan_male_dlg_past_a_past_probe_reply_0",
    "character": "apprentice_artisan_male",
    "text": "Because the mark says 'I made this.' The notch says 'I used it. It served.' Use is the only review that matters.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "artisan_male_dlg_past_a_past_probe_a_past_probe_deep_reply_0",
    "character": "apprentice_artisan_male",
    "text": "Once. A blade I made for a fisherman. He brought it back after twenty years. The handle was worn into the shape of his palm. He wanted me to make it new for his daughter. I made one for the daughter and kept the worn handle. Both of us got what we wanted.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "artisan_male_dlg_past_a_past_probe_a_past_probe_back_reply_0",
    "character": "apprentice_artisan_male",
    "text": "Then I'll know I've made the right thing. The notch is the only invoice I accept.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "artisan_male_dlg_past_a_past_cold_reply_0",
    "character": "apprentice_artisan_male",
    "text": "It's the only one that didn't lie to me. The fancier myths came later and lasted shorter.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "artisan_male_dlg_calling_opener_0",
    "character": "apprentice_artisan_male",
    "text": "There is a single object I am working toward. It is not a commission. It will not be sold. It will not be displayed.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "artisan_male_dlg_calling_opener_1",
    "character": "apprentice_artisan_male",
    "text": "It will be left in a drawer in a room I will not own.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "artisan_male_dlg_calling_a_call_warm_reply_0",
    "character": "apprentice_artisan_male",
    "text": "A box. The size of a fist. The lid takes seventeen movements to open and the movements are not the same twice. Inside: a single notch. Whoever opens it will know they have been used. They will keep it.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "artisan_male_dlg_calling_a_call_probe_reply_0",
    "character": "apprentice_artisan_male",
    "text": "Because the price would lie. The box is not worth a price. It is worth a chance encounter and the right hands. Markets cannot do that.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "artisan_male_dlg_calling_a_call_probe_a_call_probe_deep_reply_0",
    "character": "apprentice_artisan_male",
    "text": "If you find it in the right drawer, yes. The drawer is on this ark. The room is not yet built. I am, in fact, working on the room. The box is patient. So am I.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "artisan_male_dlg_calling_a_call_probe_a_call_probe_back_reply_0",
    "character": "apprentice_artisan_male",
    "text": "I won't. Markets get enough. The box is for the person who is not the market.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "artisan_male_dlg_calling_a_call_cold_reply_0",
    "character": "apprentice_artisan_male",
    "text": "Yes. The market always pays a lot for the things that lie. The box would not survive being bought.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "artisan_male_dlg_mortality_opener_0",
    "character": "apprentice_artisan_male",
    "text": "If I die, give every piece I made to someone who will use it. Don't display. Don't archive.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "artisan_male_dlg_mortality_opener_1",
    "character": "apprentice_artisan_male",
    "text": "If a piece comes back to my workshop unused, melt it.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "artisan_male_dlg_mortality_a_mort_warm_reply_0",
    "character": "apprentice_artisan_male",
    "text": "Then the workshop becomes a useful place. The pieces go where they belong. The notches will accumulate. I will be there in the notches.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "artisan_male_dlg_mortality_a_mort_probe_reply_0",
    "character": "apprentice_artisan_male",
    "text": "The box has its own rule. Leave it in the drawer. The right hands will find it. Don't help. Helping breaks the rule.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "artisan_male_dlg_mortality_a_mort_probe_a_mort_probe_deep_reply_0",
    "character": "apprentice_artisan_male",
    "text": "Then it waits. The box is patient. The notch on the spoon waited forty years. The box can wait longer.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "artisan_male_dlg_mortality_a_mort_probe_a_mort_probe_back_reply_0",
    "character": "apprentice_artisan_male",
    "text": "Thank you. The box is the only thing I leave behind that I do not want managed.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "artisan_male_dlg_mortality_a_mort_cold_reply_0",
    "character": "apprentice_artisan_male",
    "text": "Archive is a polite word for storage. Storage is what you do with what failed. Don't insult the work. Use it. Or melt it.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "artisan_male_dlg_us_opener_0",
    "character": "apprentice_artisan_male",
    "text": "I made you a thing. It's small. It's heavy. The weight is the point.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "artisan_male_dlg_us_opener_1",
    "character": "apprentice_artisan_male",
    "text": "I'll bring it tonight. You'll know what it is when you hold it.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "artisan_male_dlg_us_a_us_warm_reply_0",
    "character": "apprentice_artisan_male",
    "text": "Use it. Don't keep it pretty. Wear it down. The notch is the only proof I made it for you.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "artisan_male_dlg_us_a_us_probe_reply_0",
    "character": "apprentice_artisan_male",
    "text": "Because you forget what's light. The weight makes you remember the pocket it's in. You will think of me at irregular intervals because of it. That's the design.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "artisan_male_dlg_us_a_us_probe_a_us_probe_deep_reply_0",
    "character": "apprentice_artisan_male",
    "text": "Then someone will find it. They will keep it. The notch will travel. I am, in a small way, content with that ending.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "artisan_male_dlg_us_a_us_probe_a_us_probe_step_reply_0",
    "character": "apprentice_artisan_male",
    "text": "Good. The pocket gets used to the weight. So do you.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "artisan_male_dlg_us_a_us_cold_reply_0",
    "character": "apprentice_artisan_male",
    "text": "Then it's not a gift. It's a tool. Take it. Use it. The notch will not care about the noun.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  }
]
