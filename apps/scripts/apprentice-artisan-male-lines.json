  },
  {
    "id": "artisan_male_ambient_7",
    "character": "apprentice_artisan_male",
    "text": "Sloppy welds outlive the welder. Always.",
    "emotion": "edged",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_ambient_8",
    "character": "apprentice_artisan_male",
    "text": "The Engineer Zero brings me singular pigments. I owe him three lifetimes.",
    "emotion": "warm",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_ambient_9",
    "character": "apprentice_artisan_male",
    "text": "Patina is a story. Don't polish it off.",
    "emotion": "soft",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "artisan_male_deploy_3",
