[
  {
    "id": "revenant_male_greet_1",
    "character": "apprentice_revenant_male",
    "text": "I came back. That's most of the introduction.",
    "emotion": "low",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_greet_2",
    "character": "apprentice_revenant_male",
    "text": "Welcome. I'll tell you which parts of my story you can ask about.",
    "emotion": "set",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_ambient_1",
    "character": "apprentice_revenant_male",
    "text": "I had a debt list in my coat pocket when I died. I keep finding new copies.",
    "emotion": "low",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_ambient_2",
    "character": "apprentice_revenant_male",
    "text": "There's a hum in this corridor that wasn't there before. Or after. Hard to tell.",
    "emotion": "wry",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_ambient_3",
    "character": "apprentice_revenant_male",
    "text": "Sleep doesn't take me anywhere new. That's fine. I'm not done with here.",
    "emotion": "still",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_deploy_1",
    "character": "apprentice_revenant_male",
    "text": "I've done this corridor before. Not the same way.",
    "emotion": "set",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_deploy_2",
    "character": "apprentice_revenant_male",
    "text": "Don't worry about me dying. I'm bad at it.",
    "emotion": "wry",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_outcome_won",
    "character": "apprentice_revenant_male",
    "text": "Crossed two names off. Three to go.",
    "emotion": "low",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_outcome_wounded",
    "character": "apprentice_revenant_male",
    "text": "Hurts the same. That's a relief, somehow.",
    "emotion": "wry",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_outcome_saw_death",
    "character": "apprentice_revenant_male",
    "text": "I know what he're feeling. I'll go sit with the body for a while.",
    "emotion": "mourning",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_outcome_other_died",
    "character": "apprentice_revenant_male",
    "text": "He got there before me. Add his name to my list. I'll finish what he started.",
    "emotion": "mourning",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_event_loredex",
    "character": "apprentice_revenant_male",
    "text": "That fragment? Mine. I think.",
    "emotion": "low",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_event_resurrection",
    "character": "apprentice_revenant_male",
    "text": "Welcome back. Don't try to remember everything at once. The hour after's the worst.",
    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_banter_died",
    "character": "apprentice_revenant_male",
    "text": "Yes I died. No I won't tell you how. Yes you can ask in three cycles.",
    "emotion": "edged",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_banter_finish",
    "character": "apprentice_revenant_male",
    "text": "There are five names I owe. Three are still alive. We could go.",
    "emotion": "set",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_quest_1_open",
    "character": "apprentice_revenant_male",
    "text": "First name on the debt list lives two sectors over. I'd like company.",
    "emotion": "set",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_quest_2_mid",
    "character": "apprentice_revenant_male",
    "text": "Found three. Two thanked me. One slammed the door.",
    "emotion": "wry",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_quest_3_break",
    "character": "apprentice_revenant_male",
    "text": "The last name on the list — it's mine. I don't know how to settle that one yet.",
    "emotion": "raw",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_romance_spark",
    "character": "apprentice_revenant_male",
    "text": "Slow steps. I came back walking funny.",
    "emotion": "soft",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_romance_courtship",
    "character": "apprentice_revenant_male",
    "text": "I die a little less when you laugh. Don't tell anyone.",
    "emotion": "tender",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_romance_committed",
    "character": "apprentice_revenant_male",
    "text": "I came back to finish what I'd left. I'm staying for what I've found.",
    "emotion": "warm",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_greet_3",
    "character": "apprentice_revenant_male",
    "text": "Welcome. The list is getting shorter. Slowly.",
    "emotion": "low",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_greet_4",
    "character": "apprentice_revenant_male",
    "text": "I'm okay. I'm here. Both true.",
    "emotion": "ready",
    "bucket": "greet",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_ambient_4",
    "character": "apprentice_revenant_male",
    "text": "I keep finding things in pockets I don't remember filling.",
    "emotion": "wry",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_ambient_5",
    "character": "apprentice_revenant_male",
    "text": "The third name on my list runs a stall in the lower deck. They didn't recognize me.",
    "emotion": "low",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_ambient_6",
    "character": "apprentice_revenant_male",
    "text": "Sleep takes me to the same hallway twice a week. Different lighting each time.",
    "emotion": "still",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_ambient_7",
    "character": "apprentice_revenant_male",
    "text": "I'm not afraid of dying. I'm tired of starting over.",
    "emotion": "raw",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_ambient_8",
    "character": "apprentice_revenant_male",
    "text": "There's a fifth name I haven't written down. I don't trust myself with it yet.",
    "emotion": "edged",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_ambient_9",
    "character": "apprentice_revenant_male",
    "text": "The cadre patches have changed three times since I died. I'm still learning the new ones.",
    "emotion": "thoughtful",
    "bucket": "ambient",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_deploy_3",
    "character": "apprentice_revenant_male",
    "text": "I've done worse. Less prepared.",
    "emotion": "set",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_deploy_4",
    "character": "apprentice_revenant_male",
    "text": "I'll go first. I know the ground.",
    "emotion": "low",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_deploy_5",
    "character": "apprentice_revenant_male",
    "text": "Three crossings ahead. I marked the first two last cycle.",
    "emotion": "ready",
    "bucket": "deploy",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_outcome_won_2",
    "character": "apprentice_revenant_male",
    "text": "Crossed off the fourth. The fifth's a problem.",
    "emotion": "low",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_outcome_wounded_2",
    "character": "apprentice_revenant_male",
    "text": "Old wounds. New wounds. Same body. Same accountant.",
    "emotion": "wry",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_outcome_close_call",
    "character": "apprentice_revenant_male",
    "text": "I died in three of the dream variants. Not this one.",
    "emotion": "still",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_outcome_routine_lost",
    "character": "apprentice_revenant_male",
    "text": "His unfinished business is mine now. I'll honor the addition.",
    "emotion": "mourning",
    "bucket": "outcome",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_event_act_complete",
    "character": "apprentice_revenant_male",
    "text": "Another act. Another set of names I should have written down.",
    "emotion": "thoughtful",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_event_npc_returned",
    "character": "apprentice_revenant_male",
    "text": "He're back. We compare notes on the boundary tonight.",
    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_event_betrayal_warning",
    "character": "apprentice_revenant_male",
    "text": "I've seen this before. The sequence is the same. The face is new.",
    "emotion": "edged",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_event_relationship_warm",
    "character": "apprentice_revenant_male",
    "text": "Two of you bonded in the alcove. I'm glad. The dead don't always get that.",
    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_event_demon_summon",
    "character": "apprentice_revenant_male",
    "text": "Bound spirits remind me of myself. Reluctant company.",
    "emotion": "low",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_event_apprentice_died",
    "character": "apprentice_revenant_male",
    "text": "I know what he're feeling. I'll go sit with the body. Once is enough for the witness.",
    "emotion": "mourning",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_event_resurrection_complete",
    "character": "apprentice_revenant_male",
    "text": "Welcome back. Whatever you remember, write it down. Tonight. While it's loud.",
    "emotion": "warm",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_event_recruit_added",
    "character": "apprentice_revenant_male",
    "text": "Another name to learn. I'll forget it twice and remember the third time.",
    "emotion": "wry",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_event_first_costly_choice",
    "character": "apprentice_revenant_male",
    "text": "Difficult choices age you. I'd know.",
    "emotion": "low",
    "bucket": "event",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_banter_died_2",
    "character": "apprentice_revenant_male",
    "text": "I'll tell you how I died. Once. After the second mission.",
    "emotion": "edged",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_banter_finish_2",
    "character": "apprentice_revenant_male",
    "text": "I owe a name. We could go this cycle.",
    "emotion": "set",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_banter_grief",
    "character": "apprentice_revenant_male",
    "text": "Grief from the inside is just an extra job to keep up with.",
    "emotion": "still",
    "bucket": "banter",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_quest_2_check",
    "character": "apprentice_revenant_male",
    "text": "Found the third name. He runs a paint shop now. He cried. I didn't.",
    "emotion": "raw",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_quest_followup_a",
    "character": "apprentice_revenant_male",
    "text": "The fourth name is dead. Already. I'll find the family.",
    "emotion": "still",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_quest_resolution_deep",
    "character": "apprentice_revenant_male",
    "text": "Crossed the last. The list is closed. The pen's heavier than I expected.",
    "emotion": "warm",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_quest_resolution_break",
    "character": "apprentice_revenant_male",
    "text": "I left one name uncrossed. I think I want to leave one. Always.",
    "emotion": "raw",
    "bucket": "quest",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_romance_morning",
    "character": "apprentice_revenant_male",
    "text": "I wake before you. I count your breaths. It's allowed.",
    "emotion": "soft",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_romance_quiet_walk",
    "character": "apprentice_revenant_male",
    "text": "Walk with me. Don't ask. I'll tell you about a corner of my old life.",
    "emotion": "tender",
    "bucket": "romance",
    "file": "shared/apprenticeVoiceLines.ts"
  },
  {
    "id": "revenant_male_dlg_past_opener_0",
    "character": "apprentice_revenant_male",
    "text": "I had a small flat in a town that has since been renamed. I had two friends and a dog. The dog outlived me by three cycles.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "revenant_male_dlg_past_opener_1",
    "character": "apprentice_revenant_male",
    "text": "The first time I kept a list, the dog's name was on it. I had to cross it off before I started.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "revenant_male_dlg_past_r_past_warm_reply_0",
    "character": "apprentice_revenant_male",
    "text": "Mauen. She slept on my left hip. I have not had a dog since. I am not sure I am allowed to.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "revenant_male_dlg_past_r_past_probe_reply_0",
    "character": "apprentice_revenant_male",
    "text": "Loud. Mauen recognised me. The friends did not. I carried that mismatch for a year.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "revenant_male_dlg_past_r_past_probe_r_past_probe_deep_reply_0",
    "character": "apprentice_revenant_male",
    "text": "One did. She was the second-to-last person I closed an account with. She said: 'You came back. The cycle was not done with us.' Then she made tea. The tea was the recognition.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "revenant_male_dlg_past_r_past_probe_r_past_probe_back_reply_0",
    "character": "apprentice_revenant_male",
    "text": "The dog knew first. The friends knew slowly. The list lengthened anyway. All three things, true.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "revenant_male_dlg_past_r_past_cold_reply_0",
    "character": "apprentice_revenant_male",
    "text": "Most don't. I do. I will be sentimental about the dog. The list takes care of the rest.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "past"
  },
  {
    "id": "revenant_male_dlg_calling_opener_0",
    "character": "apprentice_revenant_male",
    "text": "Three names. The first is in a town that does not exist anymore. The second is in a city that does. The third is on this ark.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "revenant_male_dlg_calling_opener_1",
    "character": "apprentice_revenant_male",
    "text": "I will not tell you the third yet.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "revenant_male_dlg_calling_r_call_warm_reply_0",
    "character": "apprentice_revenant_male",
    "text": "Then we go next cycle. The town is now a substrate quarry. The name on the list is buried under twelve metres of debris. We will not find a body. We will find what I owed.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "revenant_male_dlg_calling_r_call_probe_reply_0",
    "character": "apprentice_revenant_male",
    "text": "Because the name is one of yours. Not you. Someone you trust. I have been waiting to be wrong. I have not been wrong yet.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "revenant_male_dlg_calling_r_call_probe_r_call_probe_deep_reply_0",
    "character": "apprentice_revenant_male",
    "text": "I'll tell you the cycle before I close it. Not before. You will need that hour to ask the questions you would not ask if I told you now. I will answer all of them.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "revenant_male_dlg_calling_r_call_probe_r_call_probe_step_reply_0",
    "character": "apprentice_revenant_male",
    "text": "Acknowledged. The list waits. So do I.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "revenant_male_dlg_calling_r_call_cold_reply_0",
    "character": "apprentice_revenant_male",
    "text": "Unfinished is what death tried first. It didn't take. I'll close them. You can disapprove from a distance.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "calling"
  },
  {
    "id": "revenant_male_dlg_mortality_opener_0",
    "character": "apprentice_revenant_male",
    "text": "If I die again, do not bring me back. Once was enough. Twice would mean I have not learned the lesson.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "revenant_male_dlg_mortality_opener_1",
    "character": "apprentice_revenant_male",
    "text": "If you bring me back anyway, I will leave the list incomplete on purpose.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "revenant_male_dlg_mortality_r_mort_warm_reply_0",
    "character": "apprentice_revenant_male",
    "text": "Thank you. The Hellbox terrifies me. I have read what it does to apprentices. I would rather sleep.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "revenant_male_dlg_mortality_r_mort_probe_reply_0",
    "character": "apprentice_revenant_male",
    "text": "That the cycle has rhythms even when it includes us. The first return was a gift the cycle gave me. The second would be theft.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "revenant_male_dlg_mortality_r_mort_probe_r_mort_probe_deep_reply_0",
    "character": "apprentice_revenant_male",
    "text": "Then bear it. That's what people who knew me before learned. They did not learn it well. They learned it. So will you.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "revenant_male_dlg_mortality_r_mort_probe_r_mort_probe_back_reply_0",
    "character": "apprentice_revenant_male",
    "text": "Sit with it. The cycle will help.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "revenant_male_dlg_mortality_r_mort_cold_reply_0",
    "character": "apprentice_revenant_male",
    "text": "Then I'll come back, and I'll leave on the next mission. I will mean it kindly. I will mean it fully.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "mortality"
  },
  {
    "id": "revenant_male_dlg_us_opener_0",
    "character": "apprentice_revenant_male",
    "text": "You're on it. Not as a debt. As a witness. Different category.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "revenant_male_dlg_us_opener_1",
    "character": "apprentice_revenant_male",
    "text": "I added you the first time you walked past my bunk and didn't ask if I was okay. You knew.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "revenant_male_dlg_us_r_us_warm_reply_0",
    "character": "apprentice_revenant_male",
    "text": "Then you'll be the longest entry on the list. The witnesses age slower than the debts. Mauen taught me that.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "revenant_male_dlg_us_r_us_probe_reply_0",
    "character": "apprentice_revenant_male",
    "text": "They don't. They become me. Some part of them moves into the list itself. After I'm gone, you keep the list. I will have shown you how.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "revenant_male_dlg_us_r_us_probe_r_us_probe_deep_reply_0",
    "character": "apprentice_revenant_male",
    "text": "Then come to the bunk after the third bell. I'll show you the columns. You'll see your entry. You'll see Mauen's. The list is small. You'll be ready.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "revenant_male_dlg_us_r_us_probe_r_us_probe_step_reply_0",
    "character": "apprentice_revenant_male",
    "text": "I am ready. You are not. The list waits.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  },
  {
    "id": "revenant_male_dlg_us_r_us_cold_reply_0",
    "character": "apprentice_revenant_male",
    "text": "Off witnesses. On debts, instead. The category is worse. I'll move you back when you're sleeping.",
    "emotion": "dialogue",
    "bucket": "dialogue",
    "file": "shared/apprenticeDialogues.ts",
    "dialogueTopic": "us"
  }
